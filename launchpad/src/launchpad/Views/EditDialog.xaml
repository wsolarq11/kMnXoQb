<ContentDialog
    x:Class="Launchpad.Views.EditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:DefaultBindMode="OneWay">

    <StackPanel Width="480" Spacing="12">
        <TextBox
            Header="Name"
            PlaceholderText="Required"
            Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
        <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
            <TextBox
                Grid.Column="0"
                Header="Directory"
                PlaceholderText="e.g. D:\projects\demo"
                Text="{x:Bind ViewModel.Directory, Mode=TwoWay}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowse" Padding="10">
                <FontIcon Glyph="{StaticResource GlyphFolderOpen}" FontFamily="ms-appx:///Assets/Fonts/Lucide.ttf#Lucide" FontSize="14" />
            </Button>
        </Grid>
        <StackPanel
            Orientation="Horizontal"
            Spacing="6"
            Visibility="{x:Bind ViewModel.ShowDirectoryValidation}">
            <FontIcon
                Glyph="{x:Bind ViewModel.DirGlyph}"
                FontFamily="ms-appx:///Assets/Fonts/Lucide.ttf#Lucide"
                FontSize="12"
                Foreground="{x:Bind ViewModel.DirGlyphBrush}" />
            <TextBlock
                Text="{x:Bind ViewModel.DirectoryValidationText}"
                FontSize="12"
                Foreground="{x:Bind ViewModel.DirGlyphBrush}" />
        </StackPanel>
        <TextBox
            Header="Command"
            PlaceholderText="Required"
            Text="{x:Bind ViewModel.Command, Mode=TwoWay}" />
        <StackPanel
            Orientation="Horizontal"
            Spacing="6"
            Visibility="{x:Bind ViewModel.ShowDangerWarning}">
            <FontIcon
                Glyph="{StaticResource GlyphAlertTriangle}"
                FontFamily="ms-appx:///Assets/Fonts/Lucide.ttf#Lucide"
                FontSize="12"
                Foreground="{ThemeResource DangerBrush}" />
            <TextBlock
                Text="{x:Bind ViewModel.DangerWarning}"
                FontSize="12"
                Foreground="{ThemeResource DangerBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
        <TextBox
            Header="Terminal (optional)"
            PlaceholderText="e.g. pwsh, cmd, powershell"
            Text="{x:Bind ViewModel.Terminal, Mode=TwoWay}" />
        <CheckBox
            Content="Confirm before launch"
            IsChecked="{x:Bind ViewModel.Confirm, Mode=TwoWay}" />
    </StackPanel>
</ContentDialog>
