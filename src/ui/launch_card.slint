import { Theme } from "theme.slint";
import { Button, CheckBox } from "std-widgets.slint";

// 启动项卡片组件
export component LaunchCard {
    in property <string> item-name;
    in property <string> item-dir;
    in property <string> item-cmd;
    in property <bool> is-selected;
    in property <bool> is-dangerous;
    in property <int> item-index;

    callback launched(int);
    callback edit-clicked(int);
    callback delete-clicked(int);
    callback selected-toggled(int, bool);

    min-width: 280px;
    min-height: Theme.card-min-height;

    Rectangle {
        background: is-dangerous ? Theme.danger : Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: is-selected ? Theme.accent : Theme.border;

        VerticalLayout {
            padding: 18px;
            spacing: 4px;

            // 卡片顶部行：名称 + 操作按钮
            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: item-name;
                    font-size: Theme.font-size;
                    font-weight: 600;
                    color: is-dangerous ? Theme.text : Theme.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // 编辑按钮（hover 显示）
                Button {
                    text: "Edit";
                    visible: touch-area.has-hover;
                    clicked => { edit-clicked(item-index); }
                }

                // 删除按钮（hover 显示）
                Button {
                    text: "Del";
                    visible: touch-area.has-hover;
                    clicked => { delete-clicked(item-index); }
                }

                // 选中复选框
                CheckBox {
                    checked: is-selected;
                    toggled => { selected-toggled(item-index, self.checked); }
                }
            }

            // 目录路径
            Text {
                text: item-dir;
                font-size: Theme.font-size-sm;
                color: is-dangerous ? Theme.text-secondary : Theme.text-secondary;
                overflow: elide;
                font-family: "Cascadia Code, Consolas, monospace";
            }

            // 命令
            Text {
                text: item-cmd;
                font-size: Theme.font-size-sm;
                color: Theme.text-tertiary;
                overflow: elide;
                font-family: "Cascadia Code, Consolas, monospace";
            }

            // 危险标记
            if is-dangerous: HorizontalLayout {
                spacing: 4px;
                Image {
                    source: @image-url("icons/alert-triangle.svg");
                    width: 14px;
                    height: 14px;
                }
                Text {
                    text: "Dangerous";
                    font-size: Theme.font-size-xs;
                    color: Theme.danger;
                }
            }
        }
// 点击卡片触发启动（命名供 hover 状态引用）
        touch-area := TouchArea {
            clicked => { launched(item-index); }
        }
    }
}
