import { Theme } from "theme.slint";
import { LaunchCard } from "launch_card.slint";
import { Dialog } from "dialog.slint";
import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";

// 卡片数据结构（导出供 C++ 层使用）
export struct LaunchCardData {
    name: string,
    dir: string,
    cmd: string,
    is-selected: bool,
    is-dangerous: bool,
}

export component MainWindow inherits Window {
    title: "WT Launcher";
    width: 800px;
    height: 600px;
    background: Theme.bg;

    // UI 状态属性（由 C++ App 层设置/读取）
    in-out property <int> stat-total;
    in-out property <string> stat-recent;
    in-out property <bool> confirm-enabled;
    in-out property <int> selected-count;

    // 对话框状态
    in-out property <bool> dialog-visible;
    in-out property <string> dialog-title;
    in-out property <string> edit-name;
    in-out property <string> edit-dir;
    in-out property <string> edit-cmd;
    in-out property <bool> edit-confirm;
    in-out property <bool> is-editing;

    // 搜索
    in-out property <string> search-query;

    // 回调（由 C++ 层绑定）
    callback toggle-confirm(bool);
    callback show-add-dialog();
    callback launch-selected();
    callback toggle-select-all(bool);
    callback item-launched(int);
    callback item-edit-clicked(int);
    callback item-delete-clicked(int);
    callback item-selected-toggled(int, bool);
    callback dialog-save(string, string, string, bool);
    callback dialog-delete();
    callback dialog-cancel();
    callback dialog-browse();
    callback search-changed(string);

    // 卡片模型（C++ 层通过 VectorModel 绑定实际数据）
    in property <[LaunchCardData]> items: [{ name: "Loading...", dir: "", cmd: "", is-selected: false, is-dangerous: false }];

    // 根容器，包含主布局和对话框遮罩
    Rectangle {
        // ── 主布局 ──
        VerticalLayout {
            // ── Header ──
            Rectangle {
                min-height: Theme.header-height;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 12px;
                    alignment: start;

                    // 品牌标
                    Rectangle {
                        width: 36px; height: 36px;
                        background: Theme.accent;
                        border-radius: 8px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: "W"; color: Theme.bg; font-weight: 700; font-size: 16px; }
                        }
                    }

                    // 标题
                    Text { text: "WT Launcher"; font-size: 24px; font-weight: 600; color: Theme.text; vertical-alignment: center; }

                    Rectangle { horizontal-stretch: 1; }

                    // 确认开关
                    HorizontalLayout {
                        spacing: 8px; alignment: center;
                        Text { text: "Confirm Launch"; font-size: 16px; color: Theme.text-secondary; vertical-alignment: center; }
                        CheckBox { checked: confirm-enabled; toggled => { toggle-confirm(self.checked); } }
                    }

                    // 新建按钮
                    Button { text: "+ New"; clicked => { show-add-dialog(); } }
                }
            }

            // ── Stats ──
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 24px;
                padding-bottom: 0;
                spacing: 14px;

                Rectangle {
                    background: Theme.surface; border-radius: Theme.radius;
                    border-width: 1px; border-color: Theme.border;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 20px;
                        padding-bottom: 20px;
                        Text { text: "ITEMS"; font-size: 14px; font-weight: 500; color: Theme.text-secondary; letter-spacing: 0.5px; }
                        Text { text: stat-total; font-size: 38px; font-weight: 700; color: Theme.text; letter-spacing: -0.5px; }
                    }
                }

                Rectangle {
                    background: Theme.surface; border-radius: Theme.radius;
                    border-width: 1px; border-color: Theme.border;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 20px;
                        padding-bottom: 20px;
                        Text { text: "RECENT"; font-size: 14px; font-weight: 500; color: Theme.text-secondary; letter-spacing: 0.5px; }
                        Text { text: stat-recent != "" ? stat-recent : "--"; font-size: 38px; font-weight: 700; color: Theme.text; letter-spacing: -0.5px; }
                    }
                }
            }

            // ── Search ──
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 8px;
                padding-bottom: 0;
                spacing: 8px;
                LineEdit { text: search-query; placeholder-text: "Search..."; font-size: 16px; horizontal-stretch: 1; edited => { search-changed(self.text); } }
            }

            // ── Batch Bar ──
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 12px;
                padding-bottom: 8px;
                spacing: 14px;
                CheckBox { text: "Select All"; font-size: 16px; toggled => { toggle-select-all(self.checked); } }
                Text { text: "Selected: " + selected-count; font-size: 15px; color: Theme.text-tertiary; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Launch Selected"; enabled: selected-count > 0; clicked => { launch-selected(); } }
            }

            // ── Card Grid ──
            ScrollView {
                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 0;
                    padding-bottom: 28px;
                    spacing: Theme.spacing;
                    for item in items: LaunchCard {
                        item-name: item.name; item-dir: item.dir; item-cmd: item.cmd;
                        is-selected: item.is-selected; is-dangerous: item.is-dangerous;
                        launched(index) => { item-launched(index); }
                        edit-clicked(index) => { item-edit-clicked(index); }
                        delete-clicked(index) => { item-delete-clicked(index); }
                        selected-toggled(index, checked) => { item-selected-toggled(index, checked); }
                    }
                }
            }

            // ── Status Bar ──
            Rectangle {
                min-height: 48px; background: Theme.surface;
                border-width: 1px; border-color: Theme.border;
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    Text { text: "Ready"; font-size: 16px; color: Theme.text-tertiary; font-family: "Cascadia Code, Consolas, monospace"; }
                }
            }
        }

        // ── Dialog Overlay ──
        if dialog-visible: Rectangle {
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.2);
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { dialog-cancel(); }
            }
            Dialog {
                title: dialog-title; edit-name: edit-name; edit-dir: edit-dir; edit-cmd: edit-cmd;
                edit-confirm: edit-confirm; is-editing: is-editing; is-visible: dialog-visible;
                save-clicked(name, dir, cmd, confirm) => { dialog-save(name, dir, cmd, confirm); }
                delete-clicked => { dialog-delete(); }
                cancel-clicked => { dialog-cancel(); }
                browse-clicked => { dialog-browse(); }
            }
        }
    }
}


