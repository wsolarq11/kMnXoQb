// WT Launcher Theme
// 浅色/深色主题变量与尺寸常量
// lucide 图标通过 src/ui/icons/ 中的 SVG 文件加载

export global Theme {
    // 浅色主题色板
    in property <color> light-bg: #ffffff;
    in property <color> light-surface: #fafafa;
    in property <color> light-border: #eeeeee;
    in property <color> light-text: #000000;
    in property <color> light-text-secondary: #999999;
    in property <color> light-text-tertiary: #cccccc;
    in property <color> light-accent: #000000;
    in property <color> light-danger: #ef4444;
    in property <color> light-success: #000000;

    // 深色主题色板
    in property <color> dark-bg: #1a1a1a;
    in property <color> dark-surface: #222222;
    in property <color> dark-border: #333333;
    in property <color> dark-text: #ffffff;
    in property <color> dark-text-secondary: #999999;
    in property <color> dark-text-tertiary: #555555;
    in property <color> dark-accent: #ffffff;
    in property <color> dark-danger: #ef4444;
    in property <color> dark-success: #ffffff;

    // 当前主题模式（由 C++ 层 settings.json.theme 控制）
    in property <bool> is-dark: false;

    // 动态色板（根据 is-dark 切换）
    in property <color> bg: is-dark ? dark-bg : light-bg;
    in property <color> surface: is-dark ? dark-surface : light-surface;
    in property <color> border: is-dark ? dark-border : light-border;
    in property <color> text: is-dark ? dark-text : light-text;
    in property <color> text-secondary: is-dark ? dark-text-secondary : light-text-secondary;
    in property <color> text-tertiary: is-dark ? dark-text-tertiary : light-text-tertiary;
    in property <color> accent: is-dark ? dark-accent : light-accent;
    in property <color> danger: is-dark ? dark-danger : light-danger;
    in property <color> success: is-dark ? dark-success : light-success;

    // 尺寸常量
    in property <length> card-width: 290px;
    in property <length> card-min-height: 110px;
    in property <length> radius: 12px;
    in property <length> radius-sm: 8px;
    in property <length> spacing: 12px;
    in property <length> spacing-lg: 20px;
    in property <length> font-size: 22px;
    in property <length> font-size-sm: 15px;
    in property <length> font-size-xs: 14px;
    in property <length> header-height: 60px;
}
