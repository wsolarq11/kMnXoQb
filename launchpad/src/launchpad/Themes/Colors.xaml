<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color tokens, aligned 1:1 with the Flutter theme.dart palette. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BaseColor">#FF0A0A0A</Color>
            <Color x:Key="SurfaceColor">#0DFFFFFF</Color>
            <Color x:Key="BorderColor">#14FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#FFF8FAFC</Color>
            <Color x:Key="TextSecondaryColor">#FF94A3B8</Color>
            <Color x:Key="TextTertiaryColor">#FF475569</Color>
            <Color x:Key="DangerBgColor">#20EF4444</Color>
            <SolidColorBrush x:Key="BaseBrush" Color="{ThemeResource BaseColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BorderColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="DangerBgBrush" Color="{ThemeResource DangerBgColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BaseColor">#FFF8FAFC</Color>
            <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="BorderColor">#14000000</Color>
            <Color x:Key="TextPrimaryColor">#FF0F172A</Color>
            <Color x:Key="TextSecondaryColor">#FF64748B</Color>
            <Color x:Key="TextTertiaryColor">#FF94A3B8</Color>
            <Color x:Key="DangerBgColor">#0DEF4444</Color>
            <SolidColorBrush x:Key="BaseBrush" Color="{ThemeResource BaseColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BorderColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="DangerBgBrush" Color="{ThemeResource DangerBgColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared tokens (theme-independent). -->
    <Color x:Key="AccentColor">#FF6366F1</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>
    <Color x:Key="SuccessColor">#FF22C55E</Color>
    <Color x:Key="NeonGlowColor">#FFA78BFA</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Lucide glyph codepoints (single source; see LucideGlyph.cs for the C# side).
         MUST stay in the F-series range (U+F100-F5A6) — that is what Lucide.ttf covers. -->
    <x:String x:Key="GlyphPlus">&#xF45E;</x:String>
    <x:String x:Key="GlyphPencil">&#xF43D;</x:String>
    <x:String x:Key="GlyphTrash2">&#xF546;</x:String>
    <x:String x:Key="GlyphChevronUp">&#xF1FD;</x:String>
    <x:String x:Key="GlyphChevronDown">&#xF1F5;</x:String>
    <x:String x:Key="GlyphZap">&#xF5A3;</x:String>
    <x:String x:Key="GlyphSearch">&#xF4AD;</x:String>
    <x:String x:Key="GlyphFolderOpen">&#xF30A;</x:String>
    <x:String x:Key="GlyphAlertTriangle">&#xF10D;</x:String>
</ResourceDictionary>
