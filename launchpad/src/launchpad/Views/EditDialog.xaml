<ContentDialog
    x:Class="Launchpad.Views.EditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glyphs="using:Launchpad"
    xmlns:local="using:Launchpad.Views"
    x:DefaultBindMode="OneWay">

    <ContentDialog.Resources>
        <local:LanguageKeyTextConverter x:Key="LanguageKeyTextConverter" />
    </ContentDialog.Resources>

    <StackPanel Width="480" Spacing="12">
        <StackPanel Spacing="4">
            <TextBox
                Header="{x:Bind ViewModel.FieldNameText}"
                PlaceholderText="{x:Bind ViewModel.PlaceholderRequiredText}"
                Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.NameError, Converter={StaticResource LanguageKeyTextConverter}}"
                FontSize="12"
                Foreground="{ThemeResource DangerBrush}"
                Visibility="{x:Bind ViewModel.HasNameError}" />
        </StackPanel>
        <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
            <TextBox
                Grid.Column="0"
                Header="{x:Bind ViewModel.FieldDirectoryText}"
                PlaceholderText="{x:Bind ViewModel.PlaceholderDirectoryText}"
                Text="{x:Bind ViewModel.Directory, Mode=TwoWay}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowse" Padding="10">
                <FontIcon Glyph="{x:Bind glyphs:LucideGlyph.FolderOpen, Mode=OneTime}" FontFamily="ms-appx:///Assets/Fonts/Lucide.ttf#Lucide" FontSize="14" />
            </Button>
        </Grid>
        <StackPanel
            Orientation="Horizontal"
            Spacing="6"
            Visibility="{x:Bind ViewModel.ShowDirectoryValidation}">
            <FontIcon
                Glyph="{x:Bind ViewModel.DirGlyph}"
                FontFamily="ms-appx:///Assets/Fonts/Lucide.ttf#Lucide"
                FontSize="12"
                Foreground="{x:Bind ViewModel.DirGlyphBrush}" />
            <TextBlock
                Text="{x:Bind ViewModel.DirectoryValidationKey, Converter={StaticResource LanguageKeyTextConverter}}"
                FontSize="12"
                Foreground="{x:Bind ViewModel.DirGlyphBrush}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBox
                Header="{x:Bind ViewModel.FieldCommandText}"
                PlaceholderText="{x:Bind ViewModel.PlaceholderRequiredText}"
                Text="{x:Bind ViewModel.Command, Mode=TwoWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.CommandError, Converter={StaticResource LanguageKeyTextConverter}}"
                FontSize="12"
                Foreground="{ThemeResource DangerBrush}"
                Visibility="{x:Bind ViewModel.HasCommandError}" />
        </StackPanel>
        <StackPanel
            Orientation="Horizontal"
            Spacing="6"
            Visibility="{x:Bind ViewModel.ShowDangerWarning}">
            <FontIcon
                Glyph="{x:Bind glyphs:LucideGlyph.AlertTriangle, Mode=OneTime}"
                FontFamily="ms-appx:///Assets/Fonts/Lucide.ttf#Lucide"
                FontSize="12"
                Foreground="{ThemeResource DangerBrush}" />
            <TextBlock
                Text="{x:Bind ViewModel.DangerWarning, Converter={StaticResource LanguageKeyTextConverter}}"
                FontSize="12"
                Foreground="{ThemeResource DangerBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
        <TextBox
            Header="{x:Bind ViewModel.FieldTerminalText}"
            PlaceholderText="{x:Bind ViewModel.PlaceholderTerminalText}"
            Text="{x:Bind ViewModel.Terminal, Mode=TwoWay}" />
        <CheckBox
            Content="{x:Bind ViewModel.CheckboxConfirmText}"
            IsChecked="{x:Bind ViewModel.Confirm, Mode=TwoWay}" />
    </StackPanel>
</ContentDialog>
