<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>WT Launcher</title>
<HTA:APPLICATION
  ID="wtLauncher"
  APPLICATIONNAME="WTLauncher"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="normal"
>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  background: #fff;
  color: #000;
  font-family: system-ui, -apple-system, sans-serif;
  font-size: 30px;
  min-width: 700px;
  user-select: none;
}

/* ── Header ── */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 28px;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid #eee;
  position: sticky;
  top: 0;
  z-index: 50;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}
.brand-mark {
  width: 36px;
  height: 36px;
  background: #000;
  color: #fff;
  font-weight: 700;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
}
.header-title {
  font-weight: 600;
  font-size: 24px;
  letter-spacing: -0.2px;
}
.header-title small {
  font-weight: 400;
  font-size: 16px;
  color: #aaa;
  margin-left: 8px;
  letter-spacing: 0;
}
.header-right {
  display: flex;
  align-items: center;
  gap: 10px;
}
.header-right .btn {
  padding: 10px 22px;
  font-size: 18px;
  font-weight: 500;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.15s;
}
.confirm-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-size: 16px;
  color: #999;
  user-select: none;
}
.confirm-toggle input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: #000;
  cursor: pointer;
}
.btn-primary {
  background: #000;
  color: #fff;
}
.btn-primary:hover {
  background: #222;
}
.btn-primary:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}
.btn-ghost {
  background: transparent;
  color: #999;
  border: 1px solid #ddd;
}
.btn-ghost:hover {
  background: #f5f5f5;
  color: #000;
}

/* ── Stats row ── */
.stats-row {
  display: flex;
  gap: 14px;
  padding: 24px 28px 0;
}
.stat-card {
  flex: 1;
  background: #fafafa;
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 20px 24px;
}
.stat-label {
  font-size: 14px;
  font-weight: 500;
  color: #aaa;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 6px;
}
.stat-value {
  font-size: 38px;
  font-weight: 700;
  letter-spacing: -0.5px;
}

/* ── Content ── */
.content {
  padding: 20px 28px 28px;
}

/* ── Batch bar ── */
.batch-bar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 0 8px;
}
.batch-bar .select-all {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-size: 16px;
  color: #999;
  user-select: none;
}
.batch-bar .select-all input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: #000;
  cursor: pointer;
}
.batch-bar .batch-count {
  font-size: 15px;
  color: #bbb;
  flex: 1;
}
.batch-bar .btn-batch {
  padding: 8px 20px;
  font-size: 16px;
  font-weight: 500;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s;
  background: #000;
  color: #fff;
}
.batch-bar .btn-batch:hover {
  background: #222;
}
.batch-bar .btn-batch:disabled {
  opacity: 0.25;
  cursor: not-allowed;
}

/* ── Button grid ── */
.btn-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  min-height: 80px;
}

/* ── Launch card ── */
.btn-card {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 290px;
  min-height: 110px;
  background: #fafafa;
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 18px;
  cursor: pointer;
  transition: all 0.15s;
}
.btn-card:hover {
  border-color: #000;
  background: #f5f5f5;
}
.btn-card:active {
  transform: scale(0.98);
}
.btn-card .card-name {
  font-weight: 600;
  font-size: 22px;
  margin-bottom: 8px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.btn-card .card-meta {
  margin-top: auto;
}
.btn-card .card-dir {
  font-size: 15px;
  color: #999;
  font-family: 'Cascadia Code', 'Consolas', monospace;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 2px;
}
.btn-card .card-cmd {
  font-size: 15px;
  color: #ccc;
  font-family: 'Cascadia Code', 'Consolas', monospace;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.btn-card .card-actions {
  position: absolute;
  top: 8px;
  right: 44px;
  display: none;
  gap: 4px;
}
.btn-card:hover .card-actions {
  display: flex;
}
.card-actions button {
  width: 32px;
  height: 32px;
  border: 1px solid #ddd;
  border-radius: 6px;
  cursor: pointer;
  font-size: 15px;
  line-height: 32px;
  text-align: center;
  padding: 0;
  transition: all 0.12s;
  background: #f0f0f0;
  color: #999;
}
.card-actions button:hover {
  border-color: #000;
  color: #000;
  background: #eaeaea;
}

/* ── Card checkbox ── */
.btn-card .card-select {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
}
.btn-card .card-select input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: #000;
  cursor: pointer;
  display: none;
}
.btn-card:hover .card-select input[type="checkbox"],
.btn-card.checked .card-select input[type="checkbox"] {
  display: block;
}
.btn-card.checked {
  border-color: #000;
  background: #f5f5f5;
}

/* ── Add card ── */
.btn-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 290px;
  min-height: 110px;
  border: 1px dashed #ddd;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.15s;
  color: #bbb;
  gap: 6px;
  background: transparent;
}
.btn-add:hover {
  border-color: #000;
  color: #000;
  background: #fafafa;
}
.btn-add .plus-icon {
  font-size: 28px;
  font-weight: 300;
  line-height: 1;
}
.btn-add .plus-label {
  font-size: 16px;
}

/* ── Empty state ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 70px 0;
  gap: 10px;
}
.empty-state .empty-icon {
  font-size: 48px;
  color: #eee;
}
.empty-state .empty-text {
  font-size: 18px;
  color: #ccc;
}

/* ── Modal ── */
.modal-overlay {
  display: none;
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.2);
  z-index: 100;
  align-items: center;
  justify-content: center;
}
.modal-overlay.active {
  display: flex;
}
.modal {
  background: #fff;
  border: 1px solid #eee;
  border-radius: 16px;
  padding: 32px;
  width: 540px;
  max-height: 85vh;
  overflow-y: auto;
  box-shadow: 0 8px 40px rgba(0,0,0,0.06);
}
.modal h2 {
  font-weight: 600;
  font-size: 24px;
  margin-bottom: 24px;
}
.form-group {
  margin-bottom: 20px;
}
.form-group label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #aaa;
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.form-group .label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.form-group input,
.form-group textarea {
  width: 100%;
  padding: 14px 16px;
  font-size: 22px;
  background: #fff;
  color: #000;
  border: 1px solid #ddd;
  border-radius: 10px;
  outline: none;
  font-family: inherit;
  transition: border-color 0.15s;
}
.form-group input:focus,
.form-group textarea:focus {
  border-color: #000;
  box-shadow: 0 0 0 3px rgba(0,0,0,0.06);
}
.form-group textarea {
  resize: vertical;
  min-height: 80px;
  font-family: 'Cascadia Code', 'Consolas', monospace;
  font-size: 18px;
}
.form-group .btn-browse {
  font-size: 14px;
  padding: 6px 14px;
  background: #f5f5f5;
  color: #999;
  border: 1px solid #ddd;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.12s;
}
.form-group .btn-browse:hover {
  border-color: #000;
  color: #000;
}
.form-hint {
  font-size: 14px;
  color: #ccc;
  margin-top: 6px;
}
.form-group input[type="checkbox"] {
  width: auto;
  padding: 0;
  margin-right: 10px;
  accent-color: #000;
}
.check-label {
  font-size: 20px;
  color: #666;
  cursor: pointer;
  user-select: none;
}

.modal-actions {
  display: flex;
  gap: 10px;
  margin-top: 28px;
}
.modal-actions .btn {
  flex: 1;
  padding: 16px;
  font-size: 20px;
  font-weight: 500;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.15s;
  border: none;
}
.modal-actions .btn-primary {
  background: #000;
  color: #fff;
}
.modal-actions .btn-primary:hover {
  background: #222;
}
.modal-actions .btn-cancel {
  background: #f0f0f0;
  color: #999;
  border: 1px solid #ddd;
}
.modal-actions .btn-cancel:hover {
  background: #e5e5e5;
  color: #000;
}
.modal-actions .btn-danger {
  background: transparent;
  color: #bbb;
  border: 1px solid #eee;
}
.modal-actions .btn-danger:hover {
  border-color: #ef4444;
  color: #ef4444;
}

/* ── Status ── */
#status {
  margin-top: 20px;
  padding: 14px 18px;
  font-family: 'Cascadia Code', 'Consolas', monospace;
  font-size: 16px;
  background: #fafafa;
  border: 1px solid #eee;
  border-radius: 10px;
  color: #ccc;
  min-height: 48px;
  word-break: break-all;
  white-space: pre-wrap;
}
#status.active {
  color: #999;
  border-color: #ddd;
}
#status.success {
  color: #000;
  border-color: #000;
}
#status.error {
  color: #666;
  border-color: #ef4444;
}

/* ── Footer ── */
.footer {
  margin-top: 14px;
  font-size: 14px;
  color: #eee;
  text-align: center;
}
</style>
</head>
<body>

<div class="header">
  <div class="header-left">
    <div class="brand-mark">W</div>
    <div class="header-title">
      WT Launcher
      <small>控制台</small>
    </div>
  </div>
  <div class="header-right">
    <label class="confirm-toggle"><input type="checkbox" id="confirmToggle" onchange="toggleConfirm(this.checked)"><span>启动确认</span></label>
    <button class="btn btn-primary" onclick="showAddDialog()">＋ 新建</button>
  </div>
</div>

<div class="stats-row">
  <div class="stat-card">
    <div class="stat-label">启动项</div>
    <div class="stat-value" id="statTotal">0</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">最近启动</div>
    <div class="stat-value" id="statRecent">—</div>
  </div>
</div>

<div class="content">
  <div class="batch-bar">
    <label class="select-all">
      <input type="checkbox" id="selectAll" onchange="toggleAll(this.checked)">
      <span>全选</span>
    </label>
    <span class="batch-count" id="selCount">已选 0 项</span>
    <button class="btn-batch" id="btnBatchLaunch" onclick="launchSelected()" disabled>▶ 启动选中</button>
  </div>
  <div id="btnGrid" class="btn-grid"></div>
  <div id="status">Ready</div>
  <div class="footer">config\config.json · Enter 启动 · Ctrl+Enter 跳过确认</div>
</div>

<!-- Modal -->
<div id="modalOverlay" class="modal-overlay" onclick="if(event.target===this)closeDialog()">
  <div class="modal">
    <h2 id="modalTitle">新建启动项</h2>
    <input type="hidden" id="editIdx" value="-1">

    <div class="form-group">
      <label for="inputName">名称</label>
      <input type="text" id="inputName" placeholder="Codex - ER Crawler">
    </div>

    <div class="form-group">
      <div class="label-row">
        <label for="inputDir">目录</label>
        <button class="btn-browse" onclick="browseFolder()">浏览…</button>
      </div>
      <input type="text" id="inputDir" placeholder="D:\_AI_\ER\crawler\Data_Acquisition_and_Analysis">
    </div>

    <div class="form-group">
      <label for="inputCmd">命令</label>
      <textarea id="inputCmd" placeholder="codex --enable goals --dangerously-bypass-approvals-and-sandbox"></textarea>
      <div class="form-hint">最终执行: wt -d "&lt;dir&gt;" pwsh -NoExit -Command "&lt;cmd&gt;"</div>
    </div>

    <div class="form-group">
      <label>
        <input type="checkbox" id="inputConfirm" checked>
        <span class="check-label">启动前确认</span>
      </label>
    </div>

    <div class="modal-actions">
      <button class="btn btn-cancel" onclick="closeDialog()">取消</button>
      <button id="dlgDeleteBtn" class="btn btn-danger" style="display:none" onclick="deleteButton()">删除</button>
      <button class="btn btn-primary" onclick="saveButton()">保存</button>
    </div>
  </div>
</div>

<script>
var fso = new ActiveXObject("Scripting.FileSystemObject");
var shell = new ActiveXObject("WScript.Shell");
function getScriptDir() {
  var p = document.location.pathname;
  if (p.charAt(0) === '/') p = p.substring(1);
  return fso.GetParentFolderName(decodeURIComponent(p));
}
var CFG = fso.BuildPath(fso.BuildPath(getScriptDir(), "config"), "config.json");
var btns = [];
var SETTINGS = fso.BuildPath(fso.BuildPath(getScriptDir(), "config"), "settings.json");
var confirmEnabled = false;
function loadSettings() {
  try {
    if (!fso.FileExists(SETTINGS)) return;
    var s = new ActiveXObject("ADODB.Stream");
    s.Charset = "utf-8"; s.Open(); s.LoadFromFile(SETTINGS);
    var t = s.ReadText(); s.Close();
    var d = JSON.parse(t);
    confirmEnabled = !!d.confirmEnabled;
  } catch(e) {}
}
function saveSettings() {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Charset = "utf-8"; s.Open();
    s.WriteText(JSON.stringify({ confirmEnabled: confirmEnabled }, null, 2));
    s.SaveToFile(SETTINGS,2); s.Close();
  } catch(e) {}
}
function toggleConfirm(on) {
  confirmEnabled = !!on;
  saveSettings();
  set(confirmEnabled ? '已启用启动确认' : '已关闭启动确认（直接启动）','active');
}

function load() {
  if (!fso.FileExists(CFG)) return [];
  function parse(t) {
    var d = JSON.parse(t);
    if (Array.isArray(d)) {
      for (var i = 0; i < d.length; i++) {
        if (d[i].confirm === undefined) d[i].confirm = true;
        if (d[i].selected === undefined) d[i].selected = false;
        if (!d[i].id) d[i].id = d[i].name || ('item_' + i);
      }
      return d;
    }
    return [];
  }
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Charset = "utf-8"; s.Open(); s.LoadFromFile(CFG);
    var t = s.ReadText(); s.Close();
    return parse(t);
  } catch(e) {
    try { var f = fso.OpenTextFile(CFG,1); var t = f.ReadAll(); f.Close(); return parse(t); }
    catch(e2) { set("配置读取失败","error"); return []; }
  }
}
function save() {
  try {
    if (fso.FileExists(CFG)) {
      var b = CFG+".bak";
      if (fso.FileExists(b)) fso.DeleteFile(b,true);
      fso.CopyFile(CFG,b,true);
    }
    for (var si = 0; si < btns.length; si++) {
      btns[si].selected = !!selected[btns[si].id];
    }
    var s = new ActiveXObject("ADODB.Stream");
    s.Charset = "utf-8"; s.Open();
    s.WriteText(JSON.stringify(btns,null,2));
    s.SaveToFile(CFG,2); s.Close();
    return true;
  } catch(e) { set("保存失败: "+e.message,"error"); return false; }
}

function render() {
  var g = document.getElementById('btnGrid'), h = '';
  document.getElementById('statTotal').textContent = btns.length;
  if (!btns.length) {
    h += '<div class="empty-state"><div class="empty-icon">⊞</div><div class="empty-text">暂无启动项，点击「新建」创建</div></div>';
  }
  for (var i = 0; i < btns.length; i++) {
    var b = btns[i];
    var n = esc(b.name||'未命名'), d = esc(b.directory||''), c = esc(b.command||'');
    var isSel = !!selected[b.id];
    h += '<div class="btn-card'+(isSel?' checked':'')+'" id="card_'+i+'" onclick="launch('+i+')">';
    h +=   '<label class="card-select"><input type="checkbox"'+(isSel?' checked':'')+' onclick="event.stopPropagation();cardCheck('+i+')"></label>';
    h +=   '<div class="card-actions">';
    h +=     '<button class="btn-edit" onclick="event.stopPropagation();editBtn('+i+')">✎</button>';
    h +=     '<button class="btn-dell" onclick="event.stopPropagation();delBtn('+i+')">✕</button>';
    h +=   '</div>';
    h +=   '<div class="card-name">'+n+'</div>';
    h +=   '<div class="card-meta">';
    if (d) h += '<div class="card-dir">'+d+'</div>';
    if (c) h += '<div class="card-cmd">'+c+'</div>';
    h +=   '</div></div>';
  }
  h += '<div class="btn-add" onclick="showAddDialog()"><div class="plus-icon">＋</div><div class="plus-label">新建启动项</div></div>';
  g.innerHTML = h;
  updateBatchUI();
}
function esc(s) {
  if (!s) return '';
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function quoteArg(s) {
  s = String(s || '');
  var out = '"', bs = 0;
  for (var i = 0; i < s.length; i++) {
    var ch = s.charAt(i);
    if (ch === '\\') { bs++; continue; }
    if (ch === '"') {
      while (bs-- > 0) out += '\\\\';
      out += '\\"'; bs = 0; continue;
    }
    while (bs-- > 0) out += '\\';
    out += ch; bs = 0;
  }
  while (bs-- > 0) out += '\\\\';
  return out + '"';
}
function trimText(s) { return String(s || '').replace(/^\s+|\s+$/g, ''); }
function buildWtCommand(b) {
  if (!b) throw new Error('启动项为空');
  var d = trimText(b.directory), c = trimText(b.command);
  if (!d) throw new Error('目录为空');
  if (!fso.FolderExists(d)) throw new Error('目录不存在: ' + d);
  if (!c) throw new Error('命令为空');
  return 'wt -d ' + quoteArg(d) + ' pwsh -NoExit -Command ' + quoteArg(c);
}

/* ── Batch select ── */
var selected = {};
function cardCheck(i) {
  var cb = document.querySelector('#card_'+i+' .card-select input');
  var card = document.getElementById('card_'+i);
  var b = btns[i];
  if (cb.checked) {
    selected[b.id] = true;
    card.className = 'btn-card checked';
  } else {
    delete selected[b.id];
    card.className = 'btn-card';
  }
  updateBatchUI();
}
function toggleAll(checked) {
  for (var i = 0; i < btns.length; i++) {
    var cb = document.querySelector('#card_'+i+' .card-select input');
    var card = document.getElementById('card_'+i);
    var b = btns[i];
    if (cb) {
      cb.checked = checked;
      if (checked) { selected[b.id] = true; card.className = 'btn-card checked'; }
      else { delete selected[b.id]; card.className = 'btn-card'; }
    }
  }
  updateBatchUI();
}
function updateBatchUI() {
  var count = Object.keys(selected).length;
  document.getElementById('selCount').textContent = '已选 '+count+' 项';
  var btn = document.getElementById('btnBatchLaunch');
  btn.disabled = count === 0;
  var all = document.getElementById('selectAll');
  if (all) all.checked = count === btns.length && btns.length > 0;
}
function launchSelected() {
  var keys = Object.keys(selected);
  if (keys.length === 0) return;
  var names = [];
  for (var k = 0; k < keys.length; k++) names.push(btns[keys[k]].name);
  if (confirmEnabled && !confirm('一键启动以下 '+keys.length+' 项？\n\n'+names.join('\n'))) return;
  var ok = 0, fail = 0;
  for (var k = 0; k < keys.length; k++) {
    var b = btns[keys[k]];
    if (!b) continue;
    try {
      var c = buildWtCommand(b);
      shell.Run(c,1,false);
      ok++;
    } catch(e) { fail++; }
  }
  // clear selection
  selected = {};
  for (var i = 0; i < btns.length; i++) {
    var card = document.getElementById('card_'+i);
    if (card) card.className = 'btn-card';
  }
  updateBatchUI();
  set('✓ 一键启动: '+ok+' 成功'+(fail?', '+fail+' 失败':''), fail?'error':'success');
}

function isDangerous(cmd) {
  return /dangerously|yolo|skip-permissions|bypass-approvals|bypass-sandbox/i.test(String(cmd || ''));
}
function launch(i) {
  var b = btns[i]; if (!b) return;
  var c;
  try { c = buildWtCommand(b); }
  catch(e) { set('✕ 配置无效: '+e.message,'error'); return; }
  if (confirmEnabled && (b.confirm !== false || isDangerous(b.command))) {
    var warn = isDangerous(b.command) ? '（含危险标志，已强制确认）' : '';
    if (!confirm('启动: '+b.name+warn+'\n\n目录: '+(b.directory||'-')+'\n命令: '+(b.command||'-')+'\n\n是否继续？')) {
      set('已取消: '+b.name,'active'); return;
    }
  }
  set('启动: '+b.name+'\n❯ '+c,'active');
  try {
    shell.Run(c,1,false);
    document.getElementById('statRecent').textContent = b.name;
    set('✓ 已启动: '+b.name+'\n❯ '+c,'success');
  } catch(e) { set('✕ 失败: '+e.message+'\n❯ '+c,'error'); }
}

function showAddDialog() {
  document.getElementById('modalTitle').textContent = '新建启动项';
  document.getElementById('editIdx').value = '-1';
  document.getElementById('inputName').value='';
  document.getElementById('inputDir').value='';
  document.getElementById('inputCmd').value='codex --enable goals --dangerously-bypass-approvals-and-sandbox';
  document.getElementById('inputConfirm').checked = true;
  document.getElementById('dlgDeleteBtn').style.display = 'none';
  document.getElementById('modalOverlay').className = 'modal-overlay active';
  setTimeout(function(){document.getElementById('inputName').focus();},100);
}
function editBtn(i) {
  var b = btns[i]; if (!b) return;
  document.getElementById('modalTitle').textContent = '编辑启动项';
  document.getElementById('editIdx').value = i;
  document.getElementById('inputName').value = b.name||'';
  document.getElementById('inputDir').value = b.directory||'';
  document.getElementById('inputCmd').value = b.command||'';
  document.getElementById('inputConfirm').checked = b.confirm!==false;
  document.getElementById('dlgDeleteBtn').style.display = '';
  document.getElementById('modalOverlay').className = 'modal-overlay active';
  setTimeout(function(){document.getElementById('inputName').focus();},100);
}
function closeDialog() { document.getElementById('modalOverlay').className = 'modal-overlay'; }
function uniqueId(base) {
  var id = base, n = 2;
  while (btns.some(function(b){ return b.id === id; })) id = base + '_' + (n++);
  return id;
}
function saveButton() {
  var n = document.getElementById('inputName').value.trim();
  if (!n) { alert('请输入名称'); return; }
  var i = parseInt(document.getElementById('editIdx').value);
  var existing = (i>=0 && i<btns.length) ? btns[i] : null;
  var d = { name:n, directory:document.getElementById('inputDir').value.trim(),
    command:document.getElementById('inputCmd').value.trim(), confirm:document.getElementById('inputConfirm').checked,
    id: existing ? existing.id : uniqueId(n),
    selected: existing ? !!selected[existing.id] : false };
  if (i>=0 && i<btns.length) btns[i]=d; else btns.push(d);
  if (!save()) return;
  closeDialog(); render(); set('已保存: '+n,'success');
}
function deleteButton() {
  var i = parseInt(document.getElementById('editIdx').value);
  if (i<0||i>=btns.length) return;
  if (!confirm('删除「'+btns[i].name+'」？')) return;
  btns.splice(i,1); save(); closeDialog(); render(); set('已删除','active');
}
function delBtn(i) {
  if (i<0||i>=btns.length) return;
  if (!confirm('删除「'+btns[i].name+'」？')) return;
  btns.splice(i,1); save(); render(); set('已删除','active');
}
function browseFolder() {
  try {
    var a = new ActiveXObject("Shell.Application");
    var f = a.BrowseForFolder(0,"选择目录",0);
    if (f) { var p = f.Items().Item().Path; if (p) document.getElementById('inputDir').value = p; }
  } catch(e) { alert("浏览不可用"); }
}
function set(msg,t) {
  var e = document.getElementById('status');
  e.textContent = msg; e.className = t||'active';
}
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'&&document.getElementById('modalOverlay').className.indexOf('active')>=0){closeDialog();return;}
  if(e.key==='Enter'&&e.target.tagName==='TEXTAREA'&&!e.ctrlKey&&!e.metaKey) return;
  if(e.key==='Enter'&&(e.ctrlKey||e.metaKey)){
    if(document.getElementById('modalOverlay').className.indexOf('active')>=0){e.preventDefault();saveButton();return;}
    if(btns.length>0) launch(0);
  }
});
btns = load();
loadSettings();
var ct = document.getElementById('confirmToggle');
if (ct) ct.checked = confirmEnabled;
selected = {};
for (var li = 0; li < btns.length; li++) { if (btns[li].selected) selected[btns[li].id] = true; }
render();
set(btns.length?'已加载 '+btns.length+' 个启动项':'暂无启动项，点击「新建」创建','active');
</script>
</body>
</html>
