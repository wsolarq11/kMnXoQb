# Snow CLI runtime state
.snow/

# Local working config (contains machine-specific absolute paths)
config/config.json
config/config.json.bak
*.bak

# Archive (retired/version history binaries, kept local only)
archive/*.zip

# Build artifacts
build/
artifacts/

# Cargo/Rust build cache (CARGO_HOME)
.cargo-cache/

# CPM source cache
.cpm-cache/

# IDE / editor
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# AI agent local config (per-developer, not shared)
.agents/
.claude/
.codex/

# Runtime output logs
wt-last-err.txt
wt-last-out.txt
*.lnk

# OS files
.DS_Store
Thumbs.db

# WinUI 3 / .NET build artifacts
launchpad/src/**/bin/
launchpad/src/**/obj/
launchpad/tests/**/bin/
launchpad/tests/**/obj/
