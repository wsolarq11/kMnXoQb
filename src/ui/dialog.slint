import { Theme } from "theme.slint";
import { Button, CheckBox, LineEdit, TextEdit } from "std-widgets.slint";

// 新增/编辑启动项对话框
export component Dialog {
    in property <string> title: "New Item";
    in property <string> edit-name;
    in property <string> edit-dir;
    in property <string> edit-cmd;
    in property <bool> edit-confirm;
    in property <bool> is-editing;
    in property <bool> is-visible;

    callback save-clicked(string, string, string, bool);
    callback delete-clicked();
    callback cancel-clicked();
    callback browse-clicked();

    // 内部状态
    property <string> local-name: edit-name;
    property <string> local-dir: edit-dir;
    property <string> local-cmd: edit-cmd;
    property <bool> local-confirm: edit-confirm;

    visible: is-visible;

    Rectangle {
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        min-width: 540px;

        VerticalLayout {
            padding: 32px;
            spacing: Theme.spacing-lg;

            // 标题
            Text {
                text: title;
                font-size: 24px;
                font-weight: 600;
                color: Theme.text;
            }

            // 名称输入
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "NAME";
                    font-size: Theme.font-size-xs;
                    font-weight: 500;
                    color: Theme.text-secondary;
                    letter-spacing: 0.5px;
                }
                LineEdit {
                    text: local-name;
                    font-size: Theme.font-size;
                    edited => { local-name = self.text; }
                }
            }

            // 目录输入 + 浏览
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "DIRECTORY";
                        font-size: Theme.font-size-xs;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        letter-spacing: 0.5px;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Browse...";
                        clicked => { browse-clicked(); }
                    }
                }
                LineEdit {
                    text: local-dir;
                    font-size: Theme.font-size;
                    edited => { local-dir = self.text; }
                }
            }

            // 命令输入
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "COMMAND";
                    font-size: Theme.font-size-xs;
                    font-weight: 500;
                    color: Theme.text-secondary;
                    letter-spacing: 0.5px;
                }
                TextEdit {
                    text: local-cmd;
                    font-size: Theme.font-size;
                    edited => { local-cmd = self.text; }
                }
                Text {
                    text: "Final: wt -d \"<dir>\" pwsh -NoExit -Command \"<cmd>\"";
                    font-size: Theme.font-size-xs;
                    color: Theme.text-tertiary;
                }
            }

            // 确认开关
            HorizontalLayout {
                spacing: 10px;
                CheckBox {
                    checked: local-confirm;
                    toggled => { local-confirm = self.checked; }
                }
                Text {
                    text: "Confirm before launch";
                    font-size: Theme.font-size;
                    color: Theme.text-secondary;
                }
            }

            // 按钮行
            HorizontalLayout {
                spacing: 10px;
                Button {
                    text: "Cancel";
                    horizontal-stretch: 1;
                    clicked => { cancel-clicked(); }
                }
                if is-editing: Button {
                    text: "Delete";
                    horizontal-stretch: 1;
                    clicked => { delete-clicked(); }
                }
                Button {
                    text: "Save";
                    horizontal-stretch: 1;
                    clicked => { save-clicked(local-name, local-dir, local-cmd, local-confirm); }
                }
            }
        }
    }
}
